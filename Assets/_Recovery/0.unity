  m_Script: {fileID: 11500000, guid: c2799742275eefc4d9bad917a5d75a48, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::IncidenteInternet
  interactuableSwitch: {fileID: 351727565}
  interactuableRouter: {fileID: 804616495}
  luzIndicador: {fileID: 1681194143}
  cableDesconectado: {fileID: 466169859}
  cableConectado: {fileID: 300759062}
  matLuzRoja: {fileID: 2100000, guid: e0badeae66b50dd4ab746f70196ee6f1, type: 2}
  matLuzVerde: {fileID: 2100000, guid: 36b0f4a2b01863c44a431397c0775aac, type: 2}
  monitoresPCs:
  - {fileID: 1166324771}
  - {fileID: 2016723226}
  - {fileID: 1162212468}
  incidente:
    nombre: "Sin Conexi\xF3n a Internet"
    perdidaPorSegundo: 3
    activo: 1
    tiempoInicio: 0
    tiempoResuelto: 0
    descripcion: "<b>Diagn\xF3stico de Red:</b> Sin salida a Internet en todos los
      terminales.\nRevise las luces e inspeccione el cableado f\xEDsico del rack:"
    opciones:
    - texto: Reconectar cable switch-router
      resultado: 0
      penalizacionSegundos: 2
      deltaReputacion: 5
      resuelve: 1
      reapareceTrasSegundos: 0
      mensajeInforme: "\xA1Correcto! En problemas de red siempre se debe revisar
        primero la capa f\xEDsica (cables y luces de estado). Reconectar el cable
        restaur\xF3 la red de inmediato."
      setClientesMolestos: 0
    - texto: Reiniciar el router
      resultado: 1
      penalizacionSegundos: 30
      deltaReputacion: 0
      resuelve: 0
      reapareceTrasSegundos: 0
      mensajeInforme: "Reiniciar el router no soluciona un corte f\xEDsico de cable.
        Perdiste 30 segundos mientras los equipos continuaban sin red."
      setClientesMolestos: 0
    - texto: Llamar al proveedor
      resultado: 2
      penalizacionSegundos: 45
      deltaReputacion: -5
      resuelve: 0
      reapareceTrasSegundos: 0
      mensajeInforme: "Llamar al proveedor fue una p\xE9rdida de tiempo y reputaci\xF3n:
        el problema era local (cable desconectado), no de la empresa de telecomunicaciones."
      setClientesMolestos: 0
  incidenteBaseDatos: {fileID: 1071678890}
