--- !u!114 &1587310570
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1587310568}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 8073e5e0135603d4484c6cf3d6090d94, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::GameManager
  Dinero: 5000
  Reputacion: 70
  clientesMolestos: 0
  TiempoTranscurrido: 0
  incidentesActivos:
  - nombre: Base de Datos Eliminada
    perdidaPorSegundo: 5
    activo: 1
    tiempoInicio: 0
    tiempoResuelto: 0
    descripcion: "<b>Borrado de BD ocurrido a las:</b> <color=#F87171>10:30 a.m.</color>\nSeleccione
      un punto de restauraci\xF3n:"
    opciones:
    - texto: Hoy 6:00 a.m.
      resultado: 0
      penalizacionSegundos: 2
      deltaReputacion: 10
      resuelve: 1
      reapareceTrasSegundos: 0
      mensajeInforme: "Backup de las 6:00 a.m. restaurado con \xE9xito. Se recuper\xF3
        la base de datos limpia previa al borrado sin perder pedidos del d\xEDa."
      setClientesMolestos: 0
    - texto: Hoy 11:00 a.m.
      resultado: 2
      penalizacionSegundos: 20
      deltaReputacion: 0
      resuelve: 0
      reapareceTrasSegundos: 0
      mensajeInforme: "Deb\xEDas verificar que la hora del backup fuera anterior
        al borrado (10:30 a.m.). El backup de las 11:00 a.m. se gener\xF3 despu\xE9s
        del incidente y estaba vac\xEDo."
      setClientesMolestos: 0
    - texto: Ayer 11:00 p.m.
      resultado: 1
      penalizacionSegundos: 3
      deltaReputacion: -5
      resuelve: 1
      reapareceTrasSegundos: 0
      mensajeInforme: "El backup de ayer a las 11:00 p.m. resolvi\xF3 el problema
        pero faltan los pedidos ingresados hoy hasta las 10:30 a.m."
      setClientesMolestos: 0
    - texto: Hace una semana
      resultado: 2
      penalizacionSegundos: 4
      deltaReputacion: -20
      resuelve: 1
      reapareceTrasSegundos: 0
      mensajeInforme: "Restaurar un backup de hace una semana provoc\xF3 un desastre:
        se perdi\xF3 una semana completa de datos y los clientes est\xE1n enfurecidos."
      setClientesMolestos: 1
  - nombre: "Sin Conexi\xF3n a Internet"
    perdidaPorSegundo: 3
    activo: 1
    tiempoInicio: 0
    tiempoResuelto: 0
    descripcion: "<b>Diagn\xF3stico de Red:</b> Sin salida a Internet en todos los
      terminales.\nRevise las luces e inspeccione el cableado f\xEDsico del rack:"
    opciones:
    - texto: Reconectar cable switch-router
      resultado: 0
      penalizacionSegundos: 2
      deltaReputacion: 5
      resuelve: 1
      reapareceTrasSegundos: 0
      mensajeInforme: "\xA1Correcto! En problemas de red siempre se debe revisar
        primero la capa f\xEDsica (cables y luces de estado). Reconectar el cable
        restaur\xF3 la red de inmediato."
      setClientesMolestos: 0
    - texto: Reiniciar el router
      resultado: 1
      penalizacionSegundos: 30
      deltaReputacion: 0
      resuelve: 0
      reapareceTrasSegundos: 0
      mensajeInforme: "Reiniciar el router no soluciona un corte f\xEDsico de cable.
        Perdiste 30 segundos mientras los equipos continuaban sin red."
      setClientesMolestos: 0
    - texto: Llamar al proveedor
      resultado: 2
      penalizacionSegundos: 45
      deltaReputacion: -5
      resuelve: 0
      reapareceTrasSegundos: 0
      mensajeInforme: "Llamar al proveedor fue una p\xE9rdida de tiempo y reputaci\xF3n:
        el problema era local (cable desconectado), no de la empresa de telecomunicaciones."
      setClientesMolestos: 0
  - nombre: Impresora Desconfigurada
    perdidaPorSegundo: 1
    activo: 1
    tiempoInicio: 0
    tiempoResuelto: 0
    descripcion: "<b>Diagn\xF3stico de Impresora:</b> Caja reporta 'Sin boletas'.
      La pantalla LCD indica desconexi\xF3n.\nCausa ra\xEDz: El servidor DHCP del
      router alter\xF3 la direcci\xF3n IP:"
    opciones:
    - texto: Asignar IP fija y actualizar el puerto
      resultado: 0
      penalizacionSegundos: 2
      deltaReputacion: 5
      resuelve: 1
      reapareceTrasSegundos: 0
      mensajeInforme: "\xA1Excelente trabajo! Configurar una IP est\xE1tica en la
        impresora y actualizar el puerto TCP/IP en la estaci\xF3n de Caja soluciona
        la causa ra\xEDz permanentemente, impidiendo que el router altere la direcci\xF3n."
      setClientesMolestos: 0
    - texto: Reiniciar la impresora
      resultado: 1
      penalizacionSegundos: 3
      deltaReputacion: 0
      resuelve: 1
      reapareceTrasSegundos: 60
      mensajeInforme: "Reiniciar es un parche temporal: renueva la concesi\xF3n DHCP
        temporalmente, pero al persistir la asignaci\xF3n din\xE1mica de IP, el router
        volvi\xF3 a cambiarla y el fallo reapareci\xF3 a los 60 segundos."
      setClientesMolestos: 0
    - texto: Cambiar el cartucho
      resultado: 2
      penalizacionSegundos: 15
      deltaReputacion: -2
      resuelve: 0
      reapareceTrasSegundos: 0
      mensajeInforme: "Cambiar el cartucho fue un error: el mensaje 'NO DISPONIBLE'
        indicaba fallo de red/IP, no escasez de t\xF3ner o tinta. Perdiste 15 segundos
        y suministros."
      setClientesMolestos: 0
  finalAlcanzado: 0
  juegoTerminado: 0
  historialDecisiones: []
  incidentesTotales:
  - nombre: Base de Datos Eliminada
    perdidaPorSegundo: 5
    activo: 1
    tiempoInicio: 0
    tiempoResuelto: 0
    descripcion: "<b>Borrado de BD ocurrido a las:</b> <color=#F87171>10:30 a.m.</color>\nSeleccione
      un punto de restauraci\xF3n:"
    opciones:
    - texto: Hoy 6:00 a.m.
      resultado: 0
      penalizacionSegundos: 2
      deltaReputacion: 10
      resuelve: 1
      reapareceTrasSegundos: 0
      mensajeInforme: "Backup de las 6:00 a.m. restaurado con \xE9xito. Se recuper\xF3
        la base de datos limpia previa al borrado sin perder pedidos del d\xEDa."
      setClientesMolestos: 0
    - texto: Hoy 11:00 a.m.
      resultado: 2
      penalizacionSegundos: 20
      deltaReputacion: 0
      resuelve: 0
      reapareceTrasSegundos: 0
      mensajeInforme: "Deb\xEDas verificar que la hora del backup fuera anterior
        al borrado (10:30 a.m.). El backup de las 11:00 a.m. se gener\xF3 despu\xE9s
        del incidente y estaba vac\xEDo."
      setClientesMolestos: 0
    - texto: Ayer 11:00 p.m.
      resultado: 1
      penalizacionSegundos: 3
      deltaReputacion: -5
      resuelve: 1
      reapareceTrasSegundos: 0
      mensajeInforme: "El backup de ayer a las 11:00 p.m. resolvi\xF3 el problema
        pero faltan los pedidos ingresados hoy hasta las 10:30 a.m."
      setClientesMolestos: 0
    - texto: Hace una semana
      resultado: 2
      penalizacionSegundos: 4
      deltaReputacion: -20
      resuelve: 1
      reapareceTrasSegundos: 0
      mensajeInforme: "Restaurar un backup de hace una semana provoc\xF3 un desastre:
        se perdi\xF3 una semana completa de datos y los clientes est\xE1n enfurecidos."
      setClientesMolestos: 1
  - nombre: "Sin Conexi\xF3n a Internet"
    perdidaPorSegundo: 3
    activo: 1
    tiempoInicio: 0
    tiempoResuelto: 0
    descripcion: "<b>Diagn\xF3stico de Red:</b> Sin salida a Internet en todos los
      terminales.\nRevise las luces e inspeccione el cableado f\xEDsico del rack:"
    opciones:
    - texto: Reconectar cable switch-router
      resultado: 0
      penalizacionSegundos: 2
      deltaReputacion: 5
      resuelve: 1
      reapareceTrasSegundos: 0
      mensajeInforme: "\xA1Correcto! En problemas de red siempre se debe revisar
        primero la capa f\xEDsica (cables y luces de estado). Reconectar el cable
        restaur\xF3 la red de inmediato."
      setClientesMolestos: 0
    - texto: Reiniciar el router
      resultado: 1
      penalizacionSegundos: 30
      deltaReputacion: 0
      resuelve: 0
      reapareceTrasSegundos: 0
      mensajeInforme: "Reiniciar el router no soluciona un corte f\xEDsico de cable.
        Perdiste 30 segundos mientras los equipos continuaban sin red."
      setClientesMolestos: 0
    - texto: Llamar al proveedor
      resultado: 2
      penalizacionSegundos: 45
      deltaReputacion: -5
      resuelve: 0
      reapareceTrasSegundos: 0
      mensajeInforme: "Llamar al proveedor fue una p\xE9rdida de tiempo y reputaci\xF3n:
        el problema era local (cable desconectado), no de la empresa de telecomunicaciones."
      setClientesMolestos: 0
  - nombre: Impresora Desconfigurada
    perdidaPorSegundo: 1
    activo: 1
    tiempoInicio: 0
    tiempoResuelto: 0
    descripcion: "<b>Diagn\xF3stico de Impresora:</b> Caja reporta 'Sin boletas'.
      La pantalla LCD indica desconexi\xF3n.\nCausa ra\xEDz: El servidor DHCP del
      router alter\xF3 la direcci\xF3n IP:"
    opciones:
    - texto: Asignar IP fija y actualizar el puerto
      resultado: 0
      penalizacionSegundos: 2
      deltaReputacion: 5
      resuelve: 1
      reapareceTrasSegundos: 0
      mensajeInforme: "\xA1Excelente trabajo! Configurar una IP est\xE1tica en la
        impresora y actualizar el puerto TCP/IP en la estaci\xF3n de Caja soluciona
        la causa ra\xEDz permanentemente, impidiendo que el router altere la direcci\xF3n."
      setClientesMolestos: 0
    - texto: Reiniciar la impresora
      resultado: 1
      penalizacionSegundos: 3
      deltaReputacion: 0
      resuelve: 1
      reapareceTrasSegundos: 60
      mensajeInforme: "Reiniciar es un parche temporal: renueva la concesi\xF3n DHCP
        temporalmente, pero al persistir la asignaci\xF3n din\xE1mica de IP, el router
        volvi\xF3 a cambiarla y el fallo reapareci\xF3 a los 60 segundos."
      setClientesMolestos: 0
    - texto: Cambiar el cartucho
      resultado: 2
      penalizacionSegundos: 15
      deltaReputacion: -2
      resuelve: 0
      reapareceTrasSegundos: 0
      mensajeInforme: "Cambiar el cartucho fue un error: el mensaje 'NO DISPONIBLE'
        indicaba fallo de red/IP, no escasez de t\xF3ner o tinta. Perdiste 15 segundos
        y suministros."
