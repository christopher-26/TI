  m_Script: {fileID: 11500000, guid: 8b74f1df4bcbc984a84f16ee87587d13, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::IncidenteBaseDatos
  interactuable: {fileID: 1071678891}
  labelMonitorCaja: {fileID: 1166324771}
  incidente:
    nombre: Base de Datos Eliminada
    perdidaPorSegundo: 5
    activo: 1
    tiempoInicio: 0
    tiempoResuelto: 0
    descripcion: "<b>Borrado de BD ocurrido a las:</b> <color=#F87171>10:30 a.m.</color>\nSeleccione
      un punto de restauraci\xF3n:"
    opciones:
    - texto: Hoy 6:00 a.m.
      resultado: 0
      penalizacionSegundos: 2
      deltaReputacion: 10
      resuelve: 1
      reapareceTrasSegundos: 0
      mensajeInforme: "Backup de las 6:00 a.m. restaurado con \xE9xito. Se recuper\xF3
        la base de datos limpia previa al borrado sin perder pedidos del d\xEDa."
      setClientesMolestos: 0
    - texto: Hoy 11:00 a.m.
      resultado: 2
      penalizacionSegundos: 20
      deltaReputacion: 0
      resuelve: 0
      reapareceTrasSegundos: 0
      mensajeInforme: "Deb\xEDas verificar que la hora del backup fuera anterior
        al borrado (10:30 a.m.). El backup de las 11:00 a.m. se gener\xF3 despu\xE9s
        del incidente y estaba vac\xEDo."
      setClientesMolestos: 0
    - texto: Ayer 11:00 p.m.
      resultado: 1
      penalizacionSegundos: 3
      deltaReputacion: -5
      resuelve: 1
      reapareceTrasSegundos: 0
      mensajeInforme: "El backup de ayer a las 11:00 p.m. resolvi\xF3 el problema
        pero faltan los pedidos ingresados hoy hasta las 10:30 a.m."
      setClientesMolestos: 0
    - texto: Hace una semana
      resultado: 2
      penalizacionSegundos: 4
      deltaReputacion: -20
      resuelve: 1
      reapareceTrasSegundos: 0
      mensajeInforme: "Restaurar un backup de hace una semana provoc\xF3 un desastre:
        se perdi\xF3 una semana completa de datos y los clientes est\xE1n enfurecidos."
      setClientesMolestos: 1
